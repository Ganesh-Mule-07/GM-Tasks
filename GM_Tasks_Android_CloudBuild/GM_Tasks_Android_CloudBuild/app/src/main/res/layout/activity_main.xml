<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="16dp"
    android:background="#070B14" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:text="✓" android:textSize="28sp" android:textColor="#FFFFFF"
            android:gravity="center" android:background="#7C5CFF" android:layout_width="52dp" android:layout_height="52dp"/>
        <LinearLayout android:orientation="vertical" android:layout_marginStart="12dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:text="GM Tasks" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="22sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:text="Tasks • Reminders • Offline" android:textColor="#94A3B8" android:textSize="12sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <Button android:id="@+id/notifyButton" android:text="🔔" android:layout_width="52dp" android:layout_height="52dp"/>
    </LinearLayout>
    <LinearLayout android:orientation="horizontal" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/pendingText" android:text="Pending: 0" android:textColor="#FFFFFF" android:textSize="15sp" android:padding="12dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/completedText" android:text="Done: 0" android:textColor="#FFFFFF" android:textSize="15sp" android:padding="12dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    </LinearLayout>
    <Button android:id="@+id/addButton" android:text="＋ Add Task" android:textColor="#FFFFFF" android:backgroundTint="#7C5CFF" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
